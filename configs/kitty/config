# vim:fileencoding=utf-8:ft=conf:foldmethod=marker
#
# Only what differs from kitty's defaults. This used to be kitty's full
# annotated default dump, 1368 lines for the seven below; the reference lives
# at https://sw.kovidgoyal.net/kitty/conf/ and does not need a copy here.
#
# No `shell` setting: kitty runs the login shell from the user record, which is
# the Homebrew bash 5. Pinning /bin/bash meant every kitty window ran Apple's
# bash 3.2 while every other terminal ran 5.2.

font_family      CozetteVector
font_size        18.0

enable_audio_bell no
